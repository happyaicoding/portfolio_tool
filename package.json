{
  "name": "portfolio-tool",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "黃金龜投資組合績效報表(網站 + 桌面版)",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "python3 -m http.server 8000 --directory web",
    "test": "node tests/parse.test.mjs && node tests/xlsm.test.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --dir",
    "dist:win": "electron-builder --win portable --x64",
    "smoke": "node tests/electron-smoke.mjs && node tests/folder-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.48.0"
  },
  "build": {
    "appId": "com.happyaicoding.portfolio-tool",
    "productName": "PortfolioTool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "web/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PortfolioTool-${version}-portable.${ext}"
    }
  },
  "author": "happyaicoding"
}
